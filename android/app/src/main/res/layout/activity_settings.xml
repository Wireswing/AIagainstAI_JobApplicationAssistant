<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="LLM 配置" android:textSize="18sp" android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="API Key" android:layout_marginBottom="4dp" />
        <EditText android:id="@+id/etKey" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="你的 API Key"
            android:inputType="textPassword" android:layout_marginBottom="8dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Base URL（OpenAI 兼容）" android:layout_marginBottom="4dp" />
        <EditText android:id="@+id/etBase" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="8dp"
            android:hint="如 https://api.deepseek.com/v1" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="模型名" android:layout_marginBottom="4dp" />
        <EditText android:id="@+id/etModel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="如 deepseek-chat"
            android:layout_marginBottom="8dp" />

        <Switch android:id="@+id/swOverlay" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="启用悬浮窗显示"
            android:layout_marginBottom="8dp" />

        <Button android:id="@+id/btnSave" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="保存"
            android:layout_marginBottom="8dp" />
        <Button android:id="@+id/btnTest" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="测试生成"
            android:layout_marginBottom="12dp" />

        <TextView android:id="@+id/tvTrResult" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp"
            android:background="#F0F7FF" android:padding="12dp" />
    </LinearLayout>
</ScrollView>
